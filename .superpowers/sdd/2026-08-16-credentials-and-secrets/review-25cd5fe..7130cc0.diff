+    (root / ".env").write_text(f"PUBLISHABLE_TEST_LOADFAIL={_SENTINEL}\n")
+    subprocess.run(["git", "add", "."], cwd=root, check=True)
+    subprocess.run(
+        ["git", "-c", "user.email=t@e.com", "-c", "user.name=t", "commit", "-qm", "helper run"],
+        cwd=root,
+        check=True,
+    )
