-+    ".yaml": _encode_yaml,
-+    ".jsonl": _encode_jsonl,
-+    ".csv": _encode_csv,
-+}
-+
-+READERS = {
-+    ".json": _decode_json,
-+    ".yaml": _decode_yaml,
-+    ".jsonl": _decode_jsonl,
-+    ".csv": _decode_csv,
-+}
-+
