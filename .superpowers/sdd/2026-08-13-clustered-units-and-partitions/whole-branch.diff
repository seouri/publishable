+    got = weighted_t_over_units_clustered(
+        _WEIGHTED_CLUSTER_VALUES,
+        _WEIGHTED_CLUSTER_KEYS,
+        _WEIGHTED_CLUSTER_MEMBERSHIP,
+        _WEIGHTED_CLUSTER_WEIGHTS,
