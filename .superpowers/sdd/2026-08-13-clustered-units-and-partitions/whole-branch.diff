+        "patient_id,read_id,site,w\np1,r1,S1,2\np1,r2,S1,2\np2,r3,S3,3\n",
+    )
+    roster, technical_n, _ = resolve_units(decl, input_dir)
+    assert clusters_of(roster, "site") == {"p1": "S1", "p2": "S3"}
+    assert technical_n == {"min": 1, "max": 2, "median": 1.5}
