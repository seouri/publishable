+    squares = sum((m - mean) ** 2 for m in _CLUSTER_MEANS)
+    scaled = math.sqrt(squares / 9) / math.sqrt(10)
+    unscaled = math.sqrt(squares / 10) / math.sqrt(10)
+    half = (got.high - got.low) / 2
