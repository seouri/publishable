+def _clustered(sizes: dict[str, int]) -> tuple[UnitList, dict[str, str]]:
+    units, clusters = [], {}
+    for site, n in sizes.items():
+        for i in range(n):
+            key = f"{site}_{i}"
+            units.append(Unit(key=key, paths=(), attributes={"site": site}))
+            clusters[key] = site
+    return UnitList(units), clusters
