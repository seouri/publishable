+    "p1,a,10,r1\np1,a,20,r2\n"
+    "p2,b,30,r1\np2,b,40,r2\np2,b,90,r3\n"
+    "p3,a,11,r1\np3,a,22,r2\np3,a,66,r3\n"
+    "p4,b,12,r1\np4,b,24,r2\n"
+    "p5,a,13,r1\np5,a,26,r2\np5,a,78,r3\n"
