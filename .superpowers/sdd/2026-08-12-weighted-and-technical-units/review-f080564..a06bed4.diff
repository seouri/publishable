+    counts = attrition(results, roster, "measures_some", condition_index=0)
+    assert counts == {"resolved": 4, "completed": 3, "ineligible": 1, "failed": 0}
+    assert counts["resolved"] == counts["completed"] + counts["ineligible"] + counts["failed"]
