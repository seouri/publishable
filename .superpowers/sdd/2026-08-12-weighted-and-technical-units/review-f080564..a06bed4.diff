+            for u in list(io.units)[:3]:
+                io.record(u.key, {"v": 1.0}, measurement="r1")
+                io.record(u.key, {"v": 3.0}, measurement="r2")
+            io.skip("p3", "by design")
+            return {}
+
+    _, results, _ = harness(
