+
+    first = [dict(c.values) for c in expand(config)]
+    second = [dict(c.values) for c in expand(config)]
+
+    assert first == second
+    assert len(first) == 8
+    assert all(0.80 <= row["analysis.confidence"] <= 0.99 for row in first)
