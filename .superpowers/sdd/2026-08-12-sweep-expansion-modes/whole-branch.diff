+def _sample_config(**sample):
+    base = {
+        "n": 16,
+        "method": "random",
+        "seed": "auto",
+        "ranges": {"analysis.confidence": {"uniform": [0.80, 0.99]}},
+    }
+    base.update(sample)
+    return {"sweep": {"sample": base}}
