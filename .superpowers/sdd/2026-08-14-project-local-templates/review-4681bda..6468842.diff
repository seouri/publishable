+            "--output-dir", str(results_dir),
+        ]
+    ) == EXIT_OK
+    assert (root / "configs" / "my-experiment" / "config.yaml").exists()
+
+    assert main(
+        [
+            "generate", "experiment", "another-experiment",
+            "--template", "nope",
+            "--input-dir", str(data),
+            "--output-dir", str(results_dir),
+        ]
+    ) == EXIT_WRONG
