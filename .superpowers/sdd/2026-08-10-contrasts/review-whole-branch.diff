+    low, high = entry["ci95"]
+    assert low < entry["delta"] < high
+    # A derived metric has no per-unit value to difference, so no Cohen's d —
+    # the reason the worked example carries `cohens_d: null` for `r`.
+    assert entry["cohens_d"] is None
