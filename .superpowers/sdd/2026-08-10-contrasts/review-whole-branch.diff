+            "of": condition_dir_name(comp.of, label_by_index.get(comp.of) or ""),
+            "against": condition_dir_name(comp.against, label_by_index.get(comp.against) or ""),
+        }
+        entry.update(block)
+        out.append(entry)
+    return out or None
