+    reach `float(a) - float(b)` and crash on `TypeError` instead of being
+    dropped as a degenerate draw."""
+    of = {f"u{i}": {"m": float(i)} for i in range(60)}
+    against = {f"u{i}": {"m": float(i)} for i in range(60)}
