+# and no validate-surface test, unlike all three. Same route, same
+# `except ContractError` in `_check_units`.
+
+_HOLDOUT_MEASURED_UNITS = {
+    "from": "index.csv",
+    "key": "patient_id",
+    "attributes": ["read_id", "split"],
