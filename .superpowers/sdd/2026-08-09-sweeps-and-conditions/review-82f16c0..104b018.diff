+    root, cfg, results_dir = build_project_without_sweep(tmp_path, n_units=40)
+    assert main(["run", str(cfg)]) == EXIT_OK
+    run_dir = next(results_dir.glob("run_*"))
+    assert not (run_dir / "conditions").exists()
